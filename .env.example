# ==============================================================================
# StudySpace AI — Environment Configuration Template
# Master Architecture Baseline (Sections 8.3 & 15)
# NOTE: Store only safe placeholder names here. NEVER commit real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# General Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ------------------------------------------------------------------------------
# Supabase & Database (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# PostgreSQL database connection URL (pooler or direct)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studyspace

# Supabase Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# ------------------------------------------------------------------------------
# Model Providers: LLM Generation
# ------------------------------------------------------------------------------
# Provider choice: 'ollama' (local development) | 'gemini' (hosted deployment)
LLM_PROVIDER=ollama

# Ollama settings (Local development only; private endpoint)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2

# Gemini settings (Hosted deployment)
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_CHAT_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Model Providers: Embeddings & Reranker
# ------------------------------------------------------------------------------
# Active vector index MUST match embedding model dimension strictly
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL_ID=nomic-embed-text
EMBEDDING_VECTOR_DIMENSIONS=768

# Reranker: 'disabled' | 'local' | 'remote'
RERANKER_PROVIDER=disabled
RERANKER_MODEL_ID=

# ------------------------------------------------------------------------------
# Background Processing & Cache (Celery / Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Ingestion & Context Limits (Architecture Target: Up to 500 pages)
# ------------------------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_PAGES=500
MAX_CONTEXT_TOKENS=4000

# ------------------------------------------------------------------------------
# Frontend Variables (Exposed to browser via Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-placeholder
